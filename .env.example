# ---- required ----
DATABASE_URL=postgres://user@localhost:5432/rag_app

# local = MiniLM via Transformers.js (no account needed, 384-dim)
EMBEDDING_PROVIDER=local

# groq = free tier, no card: https://console.groq.com
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_...

# ---- required only if a provider above is set to "openai" ----
# OPENAI_API_KEY=sk-...

# ---- optional ----
PORT=3000
