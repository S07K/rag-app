# ---- required ----
DATABASE_URL=postgres://user@localhost:5432/rag_app

# Embeddings. "gemini" is free (aistudio.google.com) and needs no local model;
# "local" runs MiniLM in-process — no API key, but ~460MB of RAM.
# Changing this changes the vector width: run ./scripts/reset-db.sh after.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=

# Chat model. Free tier, no card: console.groq.com
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# ---- optional ----
PORT=3000
# Cosine distance above which retrieved chunks are discarded. Scale is
# model-specific; defaults to 0.4 (gemini) / 0.8 (local).
# RELEVANCE_MAX_DISTANCE=0.4
# Run ingestion inside the API process (hosts with only one service).
# RUN_WORKER_INLINE=true
